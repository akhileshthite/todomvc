node_modules/

# Everything below is generated at the repo root only, so the patterns are
# anchored with a leading slash. Without it `contracts/` would also match
# `src/contracts/`, which holds the contract source.
/dist/
/build/
/data/

# Generated by `npm run contracts`
/contracts/
/chelonia.json
/src/contracts/manifests.json

# Contract signing key.
/.keys/

# Generated by `chel init`, contains a server_id unique to this checkout.
/chel.toml

# Task list for the coding agent, see https://github.com/taoeffect/tasks
/.agents/

# Written by `npx skills add`
/.claude/
/skills-lock.json

.DS_Store
